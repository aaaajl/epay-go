# 复制为 .env 后使用：cp .env.example .env && chmod 600 .env
# start.sh local|prod 会覆盖 DB_HOST / REDIS_HOST，勿依赖下面这两项作为最终地址。
#
#   local → DB 101.132.81.209（公网），Redis 默认共享网络里的 redis
#   prod  → DB 172.16.0.246（内网），Redis 默认共享网络里的 redis

# 镜像（本地先 ./build.sh；生产由 deploy-prod.sh 上传 linux/amd64 包）
IMAGE=epay-go:local

# 宿主机对外端口（容器内 8080）
HTTP_PORT=3889

# 共享 PostgreSQL（与 new-api 同一实例，库名独立）
# 独立库账号可改 DB_USER / DB_PASSWORD；共享 new-api 时用 POSTGRES_*，start.sh 优先采用它们
POSTGRES_USER=root
POSTGRES_PASSWORD=2026@Biscuits
DB_USER=epay
DB_PASSWORD=epay123
DB_NAME=epay
DB_PORT=5432

# 共享 Redis（DB 1，避免和 new-api 的 0 号库冲突）
REDIS_PASSWORD=2026@Biscuits
REDIS_PORT=6379
REDIS_DB=1
# 仅当不走 start.sh 的 local|prod 默认值时才需要手写
# REDIS_HOST=redis
# DB_HOST=101.132.81.209

# 必须与 redis 容器在同一 Docker 网络，否则解析不到主机名 redis
# 根 compose 常见 new-api_new-api-network；master-slave 常见 master-slave_new-api-network
# 生产机按实际网络填写（如 wingrid-api_new-api-network）
SHARED_NETWORK=new-api_new-api-network

# JWT
JWT_SECRET=secret-key-for-jwt-in-production

# 默认管理员（仅数据库中不存在管理员时生效）
DEFAULT_ADMIN_USERNAME=root
DEFAULT_ADMIN_PASSWORD=2026@Biscuits

# 构建镜像加速（Mac 构建时使用，可不改）
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com
DOCKER_REGISTRY_MIRROR=docker.m.daocloud.io/library
APK_MIRROR=mirrors.aliyun.com
