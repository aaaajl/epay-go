# epay-go 环境变量
# 复制为 .env 后按需修改: cp .env.example .env
# 与项目根目录 .env / .env.example 保持一致

# 数据库配置（独立部署 docker-compose.yml 时使用）
DB_USER=epay
DB_PASSWORD=epay123
DB_NAME=epay
DB_PORT=5432

# 共享 new-api 基础设施时
POSTGRES_USER=root
POSTGRES_PASSWORD=2026@Biscuits
SHARED_NETWORK=wingrid-api_new-api-network
REDIS_PASSWORD=2026@Biscuits
REDIS_DB=1

# 宿主机对外端口
HTTP_PORT=3889

# Go 模块代理
GOPROXY=https://goproxy.cn,direct

# JWT 密钥
JWT_SECRET=secret-key-for-jwt-in-production

# 默认管理员初始化（仅数据库中不存在管理员时生效）
